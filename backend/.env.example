ENVIRONMENT=development
STORAGE_MODE=local
# For deployed frontend URLs, set this to your Render static site URL.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional in local dev. On Render, use the Supabase pooled PostgreSQL DATABASE_URL.
# Example: postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Provider order is role-specific below; these are available integrations.
MODEL_PROVIDER_ORDER=groq,gemini,ollama,openrouter,nvidia,huggingface
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=0
MODEL_TEMPERATURE=0.1
OLLAMA_BASE_URL=http://localhost:11434
TRUSTED_SEARCH_DOMAINS=react.dev,nextjs.org,vite.dev,developer.mozilla.org,docs.python.org,fastapi.tiangolo.com,python.langchain.com,js.langchain.com,docs.pydantic.dev,docs.sqlalchemy.org,npmjs.com,pypi.org,github.com
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_TIMEOUT_SECONDS=8
VISION_ANALYSIS_TIMEOUT_SECONDS=35
MAX_ZIP_BYTES=1073741824
MAX_PROJECT_FILES=300
MAX_FILE_BYTES=350000
MAX_IMAGE_BYTES=5000000

# API keys. Leave blank to skip that provider.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=

# Role-based fallback chains.
SUPERVISOR_REASONING_MODELS=groq:openai/gpt-oss-20b,gemini:gemini-2.5-flash,ollama:qwen2.5-coder:3b,groq:openai/gpt-oss-120b,gemini:gemini-2.5-pro,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
DEBUGGER_CODING_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash,ollama:qwen2.5-coder:3b,openrouter:cohere/north-mini-code:free
COMMENTER_CODE_DOCS_MODELS=groq:openai/gpt-oss-20b,gemini:gemini-2.5-flash-lite,ollama:qwen2.5-coder:3b,openrouter:cohere/north-mini-code:free
ARCHITECTURE_DESIGN_MODELS=gemini:gemini-2.5-flash,ollama:qwen2.5-coder:3b,groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
RETRIEVAL_QUERY_MODELS=gemini:gemini-2.5-flash-lite,ollama:qwen2.5-coder:3b,groq:openai/gpt-oss-20b
VISION_ERROR_ANALYSIS_MODELS=gemini:gemini-2.5-flash,nvidia:meta/llama-3.2-90b-vision-instruct,nvidia:meta/llama-3.2-11b-vision-instruct,openrouter:google/gemini-2.5-flash,ollama:llava:7b
GUARDRAIL_MODELS=gemini:gemini-2.5-flash-lite,groq:llama-guard-4-12b
EMBEDDING_MODELS=gemini:gemini-embedding-001,huggingface:sentence-transformers/all-MiniLM-L6-v2,ollama:nomic-embed-text

# LangSmith observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=CodeGraph_AI
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
